{
  "name": "patisserie",
  "displayName": "Patisserie",
  "description": "Manage Pi sessions",
  "version": "0.0.14",
  "publisher": "j-lootens",
  "repository": {
    "type": "git",
    "url": "https://github.com/j-lootens/patisserie.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "patisserie",
          "title": "Pi Sessions",
          "icon": "media/sessions.svg"
        }
      ],
      "panel": [
        {
          "id": "patisserieBeach",
          "title": "Beach",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "patisserie": [
        {
          "id": "patisserie.sessions",
          "name": "Sessions"
        },
        {
          "id": "patisserie.context",
          "name": "Context"
        }
      ],
      "patisserieBeach": [
        {
          "type": "webview",
          "id": "patisserie.beach",
          "name": "Beach",
          "when": "patisserie.beachVisible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "patisserie.sessions",
        "contents": "No Pi sessions for this workspace."
      },
      {
        "view": "patisserie.context",
        "contents": "Select a session to see the prompts, context files, skills and files it used."
      }
    ],
    "commands": [
      {
        "command": "patisserie.continueSession",
        "title": "Continue Latest Session",
        "icon": "$(play)",
        "category": "Pi"
      },
      {
        "command": "patisserie.newSession",
        "title": "New Named Session",
        "icon": "$(add)",
        "category": "Pi"
      },
      {
        "command": "patisserie.forkSession",
        "title": "Fork Session in Terminal",
        "icon": "$(git-branch)",
        "category": "Pi"
      },
      {
        "command": "patisserie.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Pi"
      },
      {
        "command": "patisserie.openSession",
        "title": "Open Session in Terminal",
        "category": "Pi"
      },
      {
        "command": "patisserie.showContext",
        "title": "Show Context",
        "icon": "$(book)",
        "category": "Pi"
      },
      {
        "command": "patisserie.renameSession",
        "title": "Rename Session…",
        "icon": "$(edit)",
        "category": "Pi"
      },
      {
        "command": "patisserie.openBeach",
        "title": "Open Beach",
        "category": "Pi"
      },
      {
        "command": "patisserie.closeBeach",
        "title": "Close Beach",
        "icon": "$(close)",
        "category": "Pi"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "patisserie.newSession",
          "when": "view == patisserie.sessions",
          "group": "navigation@1"
        },
        {
          "command": "patisserie.continueSession",
          "when": "view == patisserie.sessions",
          "group": "navigation@2"
        },
        {
          "command": "patisserie.refresh",
          "when": "view == patisserie.sessions",
          "group": "navigation"
        },
        {
          "command": "patisserie.closeBeach",
          "when": "view == patisserie.beach",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "patisserie.forkSession",
          "when": "false"
        },
        {
          "command": "patisserie.openSession",
          "when": "false"
        },
        {
          "command": "patisserie.showContext",
          "when": "false"
        },
        {
          "command": "patisserie.renameSession",
          "when": "false"
        },
        {
          "command": "patisserie.openBeach",
          "when": "!patisserie.beachVisible"
        },
        {
          "command": "patisserie.closeBeach",
          "when": "patisserie.beachVisible"
        }
      ],
      "view/item/context": [
        {
          "command": "patisserie.forkSession",
          "when": "view == patisserie.sessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "patisserie.showContext",
          "when": "view == patisserie.sessions && viewItem == session",
          "group": "inline"
        },
        {
          "command": "patisserie.showContext",
          "when": "view == patisserie.sessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "patisserie.renameSession",
          "when": "view == patisserie.sessions && viewItem == session",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Patisserie",
      "properties": {
        "patisserie.piPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Pi CLI. Leave empty to find `pi` on `PATH`."
        }
      }
    },
    "keybindings": [
      {
        "command": "patisserie.renameSession",
        "key": "f2",
        "when": "focusedView == patisserie.sessions"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "install-local": "sh scripts/install.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
