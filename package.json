{
  "name": "patisserie",
  "displayName": "Patisserie",
  "description": "Manage Pi sessions",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "patisserie",
          "title": "Pi Sessions",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "patisserie": [
        {
          "id": "patisserie.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "patisserie.sessions",
        "contents": "No Pi sessions for this workspace."
      }
    ],
    "commands": [
      {
        "command": "patisserie.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Pi"
      },
      {
        "command": "patisserie.openSession",
        "title": "Open Session in Terminal",
        "category": "Pi"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "patisserie.refresh",
          "when": "view == patisserie.sessions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "patisserie.openSession",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Patisserie",
      "properties": {
        "patisserie.piPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Pi CLI. Leave empty to find `pi` on `PATH`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
